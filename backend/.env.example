# ===========================================
# Sign Language Platform - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to Git!

# --- MongoDB Atlas Connection ---
# For VERCEL (use +srv format, DNS works on Vercel):
# MONGODB_URI=mongodb+srv://3asdjk5_db_user:<password>@cluster0.qta5h4r.mongodb.net/sign_language_db?retryWrites=true&w=majority&appName=Cluster0
#
# For LOCAL DEV (use direct shards if SRV DNS fails):
MONGODB_URI=mongodb://USER:PASS@ac-k23now8-shard-00-00.qta5h4r.mongodb.net:27017,ac-k23now8-shard-00-01.qta5h4r.mongodb.net:27017,ac-k23now8-shard-00-02.qta5h4r.mongodb.net:27017/sign_language_db?ssl=true&replicaSet=atlas-zn6q44-shard-0&authSource=admin&retryWrites=true&w=majority

# --- JWT Secrets (use a long random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production

# --- Google OAuth2 (from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# --- Resend Email API (from https://resend.com)
RESEND_API_KEY=re_your_resend_api_key

# --- App Base URL
BASE_URL=http://localhost:5000

# --- AI Service URL
AI_BASE_URL=https://abdallahessam29-sign-language-ai.hf.space

# --- Server Port
PORT=5000
