# ===========================================
# Sign Language Platform - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to Git!

# --- MongoDB Atlas Connection ---
# Get this from: https://cloud.mongodb.com -> Your Cluster -> Connect -> Drivers
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/sign_language_db?retryWrites=true&w=majority

# --- JWT Secrets (use a long random string, e.g. from: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production

# --- Google OAuth2 (from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# --- Resend Email API (from https://resend.com)
RESEND_API_KEY=re_your_resend_api_key

# --- App Base URL (for email links)
BASE_URL=http://localhost:5000

# --- AI Service URL
AI_BASE_URL=https://abdallahessam29-sign-language-ai.hf.space

# --- Server Port
PORT=5000
